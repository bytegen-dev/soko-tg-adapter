{
  "name": "soko-tg-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "start:prod": "node --env-file=.env dist/index.js",
    "get-chat-id": "node --env-file=.env scripts/get-chat-id.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "check": "pnpm typecheck && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "grammy": "1.38.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
